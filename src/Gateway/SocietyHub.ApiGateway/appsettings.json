            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api/gate"
          }
        ]
      },
      "society-route": {
        "ClusterId": "society-cluster",
        "Match": {
          "Path": "/api/society/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api/society"
          }
        ]
      },
