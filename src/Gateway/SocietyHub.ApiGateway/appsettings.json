    "Clusters": {
      "helpdesk-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://helpdesk-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/alive"
          }
        }
      },
