@inherits LayoutComponentBase
@implements IDisposable
@inject SocietyHubApiClient Api
@inject LanguageService Language
@inject NavigationManager Navigation

@*
    The shell.

    Two things happen here and nowhere else: the feature manifest is fetched once and cascaded
    to every page, and the language is resolved before anything renders. Both are start-up
    concerns — doing either per page would mean a request per navigation for data that changes
    a few times a month.
*@

@if (_me is not null && !ConsoleAccess.IsAdmitted(_me))
{
    @*
        Shown instead of the shell, not alongside it. Rendering the navigation and then
        failing every panel with a 403 is technically correct and reads as a broken app;
        this says what happened and what to use instead.
    *@
    <main class="sh-shell sh-shell--anonymous">
        <div class="sh-signin-page">
            <h1 class="sh-signin__title">@Strings.Access_WrongAppTitle</h1>
            <p>@Strings.Access_WrongAppBody</p>

            <p class="sh-signin__hint">
                @string.Format(Strings.Access_SignedInAsRole, string.Join(", ", _me.Roles))
            </p>

            @* A way out. A dead end on a shared machine leaves the next person holding
               somebody else's session. *@
            <button type="button" class="sh-signin__primary" @onclick="SignOutAsync">
                @Strings.Common_SignOut
            </button>

            <LanguageSwitcher OnChanged="OnLanguageChangedAsync" />
        </div>
    </main>
}
else
{
<CascadingValue Value="_manifest">
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <LanguageSwitcher OnChanged="OnLanguageChangedAsync" />

                @if (_me is not null)
                {
                    <span class="sh-shell__user">
                        @string.Format(Strings.SignIn_SignedInAs, _me.FullName)
                    </span>

                    <button type="button" class="sh-shell__signout" @onclick="SignOutAsync">
                        @Strings.Common_SignOut
                    </button>
                }
            </div>

            <article class="content px-4">
                @if (_configurationError is not null)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Configuration problem.</strong> @_configurationError
                    </div>
                }

                @if (_loadFailed)
                {
                    @*
                        The console still works with no manifest — it renders the baseline menu
                        and the server refuses anything the society lacks. Blocking the whole
                        app on a manifest fetch would make a Redis blip look like an outage.
                    *@
                    <div class="alert alert-warning" role="alert">
                        @Strings.Error_Network
                        <button class="btn btn-link" @onclick="LoadAsync">@Strings.Common_Retry</button>
                    </div>
                }

                @Body
            </article>
        </main>
    </div>
</CascadingValue>
}

@code {
    private FeatureManifestView? _manifest;
    private bool _loadFailed;
    private string? _configurationError;
    private MeView? _me;

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;

        await Language.InitialiseAsync(societyDefault: null);

        // Checked before anything else. Loading the manifest first would fire a 401 that the
        // API client handles by clearing the session — which is harmless but produces an
        // error flash on every visit by a signed-out person.
        if (!await Api.IsSignedInAsync())
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        await LoadAsync();
    }

    private async Task SignOutAsync()
    {
        await Api.SignOutAsync();

        // forceLoad, so the cascaded manifest and every cached page state go with the session
        // rather than lingering for the next person at a shared machine.
        Navigation.NavigateTo(Navigation.BaseUri + "sign-in", forceLoad: true);
    }

    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;

    private async Task LoadAsync()
    {
        _loadFailed = false;
        _configurationError = null;

        try
        {
            _manifest = await Api.GetFeaturesAsync();
            _me = await Api.GetMeAsync();
        }
        catch (ApiException ex) when (ex.IsUnauthorised)
        {
            // Not an error worth showing. The API client has already cleared the session and
            // raised SessionExpired; the sign-in redirect is on its way.
            _manifest = null;
        }
        catch (ApiException ex) when (ex.IsMisconfigured)
        {
            // Deliberately shown as the developer-facing message rather than the localised
            // network error. A resident never sees this — it only happens when the console is
            // pointed at the wrong host, and whoever sees it needs the actual reason.
            _configurationError = ex.Message;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Reloads the page rather than re-rendering.
    ///
    /// Two reasons, and the first is not optional. Blazor WebAssembly resolves a culture's
    /// satellite assemblies at start-up, so a culture set mid-session finds no loaded hi-IN
    /// resources and quietly keeps rendering English — the switcher appears to work and
    /// nothing changes. Program.cs applies the stored choice before RunAsync; this is what
    /// makes that run again.
    ///
    /// The second reason would apply anyway: notices and complaint categories arrive already
    /// translated from the server, so a language change has to refetch them or the labels
    /// change while the content stays in the old language.
    /// </summary>
    private void OnLanguageChangedAsync() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
